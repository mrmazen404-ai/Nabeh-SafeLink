# Nabeh SafeLink environment template
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
AUTH_JWT_SECRET=
AUTH_OTP_PEPPER=
AUTH_ACCESS_TOKEN_MINUTES=60
AUTH_OTP_MINUTES=10
AUTH_OTP_MAX_ATTEMPTS=5
# Isolated Administrator plane — never reuse user JWT secrets
ADMIN_JWT_SECRET=
ADMIN_JWT_ISSUER=nabeh-admin
ADMIN_JWT_AUDIENCE=nabeh-admin-api
ADMIN_TOTP_ENCRYPTION_KEY=
ADMIN_BOOTSTRAP_TOKEN=
ADMIN_TOTP_ISSUER="Nabeh Admin"
ADMIN_ACCESS_TOKEN_MINUTES=30
ADMIN_REFRESH_TOKEN_DAYS=7
ADMIN_LOGIN_RATE_LIMIT=5
ADMIN_IP_SALT=
APP_NAME="Nabeh SafeLink"
APP_VERSION=1.0.0
NABEH_LOG_LEVEL=INFO
NABEH_CORS_ALLOWED_ORIGINS=https://your-domain.example
NABEH_TRUST_MODEL_ARTIFACT=false

# Optional external providers
GEMINI_API_KEY=
VIRUSTOTAL_API_KEY=
# Public configuration from the EmailJS project (not secret)
EMAILJS_SERVICE_ID=service_0i98ola
EMAILJS_TEMPLATE_ID=template_cs5ud7a
EMAILJS_PUBLIC_KEY=
# Secret: set only in the server environment; never commit or zip it
EMAILJS_PRIVATE_KEY=

# Distributed guest rate limiting via Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NABEH_RATE_LIMIT_SALT=
NABEH_GUEST_RATE_LIMIT=10
NABEH_GUEST_RATE_WINDOW_SECONDS=60
NABEH_RATE_LIMIT_FAIL_CLOSED=true
# Enable only when the deployment is behind a trusted reverse proxy that
# overwrites X-Forwarded-For. Keep false for direct/local deployments.
NABEH_TRUST_PROXY_HEADERS=false
