# Nabeh SafeLink — environment template
# Never commit a real .env file or any production secret.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-anon-or-publishable-key
SUPABASE_SECRET_KEY=replace-with-server-only-service-role-key
AUTH_JWT_SECRET=replace-with-at-least-64-random-characters
AUTH_OTP_PEPPER=replace-with-at-least-32-random-characters
ADMIN_JWT_SECRET=replace-with-a-different-at-least-64-random-characters
ADMIN_TOTP_ENCRYPTION_KEY=replace-with-fernet-key
ADMIN_BOOTSTRAP_TOKEN=replace-with-one-time-random-bootstrap-token
ADMIN_IP_SALT=replace-with-at-least-32-random-characters
VISITOR_HASH_SALT=replace-with-at-least-32-random-characters

# Gemini supports fallback; VirusTotal and the trusted ML artifact are required in production.
GEMINI_API_KEY=
VIRUSTOTAL_API_KEY=
NABEH_TRUST_MODEL_ARTIFACT=false
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=

# Production must use explicit HTTPS origins; local Vite defaults are included for convenience.
NABEH_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://intellidefenda.com,https://www.intellidefenda.com,https://admin.intellidefenda.com
NABEH_TRUST_PROXY_HEADERS=false
NABEH_RATE_LIMIT_SALT=replace-with-at-least-32-random-characters
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NABEH_RATE_LIMIT_FAIL_CLOSED=true
NABEH_GUEST_RATE_LIMIT=10
NABEH_GUEST_RATE_WINDOW_SECONDS=60
NABEH_PUBLIC_METRICS_RATE_LIMIT=30
NABEH_PUBLIC_METRICS_RATE_WINDOW_SECONDS=60
SCAN_AI_TIMEOUT_SECONDS=18
ADMIN_ACCESS_TOKEN_MINUTES=30
ADMIN_REFRESH_TOKEN_DAYS=7
ADMIN_LOGIN_RATE_LIMIT=5
